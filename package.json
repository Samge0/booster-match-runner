{
  "name": "booster-match-runner",
  "displayName": "Booster Match Runner",
  "description": "Unofficial community panel to run 3v3 soccer matches between Booster agents (requires Booster Studio + the virtual-robot sim container).",
  "version": "0.2.6",
  "publisher": "samge",
  "license": "MIT",
  "icon": "media/icon.png",
  "keywords": [
    "booster",
    "booster-studio",
    "robot",
    "soccer",
    "3v3",
    "simulation",
    "robocup"
  ],
  "engines": {
    "vscode": "^1.80.0",
    "boosterStudio": "1.9.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Samge0/booster-match-runner"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "booster-match",
          "title": "Match Runner",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "booster-match": [
        {
          "type": "webview",
          "id": "boosterMatch.mainView",
          "name": "Match Runner",
          "icon": "media/icon.svg",
          "contextualTitle": "Match Runner"
        }
      ]
    },
    "commands": [
      {
        "command": "boosterMatch.refresh",
        "title": "Match Runner: Refresh Agents"
      },
      {
        "command": "boosterMatch.startMatch",
        "title": "Match Runner: Start Match"
      },
      {
        "command": "boosterMatch.endMatch",
        "title": "Match Runner: End Match"
      },
      {
        "command": "boosterMatch.startHeadless",
        "title": "Match Runner: Start Headless Match"
      },
      {
        "command": "boosterMatch.showStatus",
        "title": "Match Runner: Show Match Status"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "boosterMatch.refresh",
          "when": "view == boosterMatch.mainView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Booster Match Runner",
      "properties": {
        "boosterMatch.matchLength": {
          "order": 1,
          "type": "number",
          "default": 0,
          "markdownDescription": "%settings.matchLength%"
        },
        "boosterMatch.leadGoals": {
          "order": 2,
          "type": "number",
          "default": 0,
          "markdownDescription": "%settings.leadGoals%"
        },
        "boosterMatch.ballStuckRestartCount": {
          "order": 5,
          "type": "number",
          "default": 5,
          "minimum": 0,
          "markdownDescription": "%settings.ballStuckRestartCount%"
        },
        "boosterMatch.oneSidedRestartCount": {
          "order": 6,
          "type": "number",
          "default": 5,
          "minimum": 0,
          "markdownDescription": "%settings.oneSidedRestartCount%"
        },

        "boosterMatch.hostAgentRoots": {
          "order": 20,
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%settings.hostAgentRoots%"
        },
        
        "boosterMatch.defaultOpponent": {
          "order": 100,
          "type": "string",
          "default": "com.booster.default3v3ai",
          "markdownDescription": "%settings.defaultOpponent%"
        },
        "boosterMatch.gameControlPort": {
          "order": 101,
          "type": "number",
          "default": 38383,
          "markdownDescription": "%settings.gameControlPort%"
        },
        "boosterMatch.containerName": {
          "order": 102,
          "type": "string",
          "default": "",
          "markdownDescription": "%settings.containerName%"
        },
        "boosterMatch.simImage": {
          "order": 103,
          "type": "string",
          "default": "",
          "markdownDescription": "%settings.simImage%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.0"
  }
}
